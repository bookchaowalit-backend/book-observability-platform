    "path": "systems/architecture/solo-empire-api-contract-v1.md",
    "sections": [
      {
        "anchor": "#operational-limits-and-failure-behavior",
        "line": 163,
        "answers": "Observability gap: structured logs, latency metrics, centralized audit retention"
      },
      {
        "anchor": "#authentication-classes",
        "lines": "63-65",
        "answers": "provider credentials must not be written to logs or payload metadata"
      },
      {
        "anchor": "#bookfinance-api-v1",
        "lines": "104-107",
        "answers": "audit_log keeps only redacted access metadata; raw bearer tokens and payload values never persisted"
      }
    ]
  },
  "schema": "schema/telemetry/redacted-telemetry-event.v1.schema.json",
  "retention": [
    {
      "signal": "metric",
      "retention_class": "metric-30d",
      "store": "Prometheus TSDB",
      "proposed_days": 30,
      "purge_sla_hours": 24,
      "backup": "excluded",
      "current": {
        "value": "30d",
        "source": "solo-empire@b606a119:infra/self-hosted-stack/docker-compose.yml:361"
      },
      "rationale": "covers the widest dashboard window (30D) without long-term business history"
    },
    {
      "signal": "log",
      "retention_class": "log-14d",
      "store": "Loki",
      "proposed_days": 14,
      "purge_sla_hours": 24,
      "backup": "excluded",
      "current": {
        "value": "unbounded (no compactor retention_enabled/retention_period; only reject_old_samples_max_age 168h on ingest)",
        "source": "solo-empire@b606a119:infra/self-hosted-stack/loki/loki.yml:33-38"
      },
      "rationale": "incident debugging window; logs carry the most re-identification risk so they get the shortest useful period after traces"
    },
    {
      "signal": "trace",
      "retention_class": "trace-7d",
      "store": "Tempo",
      "proposed_days": 7,
      "purge_sla_hours": 24,
      "backup": "excluded",
      "current": {
        "value": "not configured (Tempo default compactor block_retention 336h); WAL/blocks under /var/tempo while the volume mounts /tmp/tempo, so data is lost on container recreate",
        "source": "solo-empire@b606a119:infra/self-hosted-stack/tempo/tempo.yml:17-23 and docker-compose.yml:1777"
      },
      "rationale": "sampled request detail is only needed for recent latency investigation"
    },
    {
      "signal": "health_snapshot",
      "retention_class": "health-90d",
      "store": "file/object store (data/generated/briefings today)",
      "proposed_days": 90,
      "purge_sla_hours": 24,
      "backup": "excluded",
      "current": {
        "value": "unbounded; --save writes health-DATE.json with raw revenue amounts and is never pruned",
        "source": "solo-empire@99ddc05c:infra/scripts/utils/system_health.py:381-387"
      },
      "rationale": "one aggregate snapshot per day for quarter-over-quarter reliability trend; no raw records"
    }
  ],
